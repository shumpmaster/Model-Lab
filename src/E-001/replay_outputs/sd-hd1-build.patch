+/**
+ * HD1 (AC98, "Two headings on one line"; the owner's answer "Keep that part small", A, P-001-headers-wrap.md): a head's
+ * words before their first " · " at the head's own size, and " · " with what follows in its own span, small and grey
+ * (`.v2-shs`), a clock time with its day in Plex Mono (`.v2-shm`), so the heading keeps to one line on a phone. The words
+ * are unchanged and read whole: only the spans are new.
+ */
+function splitHead(words, mono) {
+  const i = words.indexOf(' · ');
+  if (i < 0) return words;
+  const rest = words.slice(i + 3);
+  return [words.slice(0, i), h('span', { class: 'v2-shs' }, ' · ', mono ? h('span', { class: 'v2-shm' }, rest) : rest)];
+}
