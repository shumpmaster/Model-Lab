+    const c = INK[way.theme];
+    for (const n of nodes(tree)) {
+      for (const [name, match, [size, weight, colour, family], extra] of ROLES) {
+        if (!match(n)) continue;
+        met.add(`${name} · ${way.name}`);
+        const got = [plain(n.style.get('font-size')), plain(n.style.get('font-weight')), plain(n.style.get('color')).toLowerCase(), plain(n.style.get('font-family'))];
+        const bad = [];
+        if (size && got[0] !== size) bad.push(`size ${got[0]}, not ${size}`);
+        if (weight && got[1] !== weight) bad.push(`weight ${got[1]}, not ${weight}`);
+        if (colour && got[2] !== c[colour]) bad.push(`colour ${got[2]}, not --${colour} ${c[colour]}`);
+        if (family && !family.test(got[3])) bad.push(`family ${got[3]}`);
+        if (extra && extra.lh && plain(n.style.get('line-height')) !== extra.lh) bad.push(`line height ${plain(n.style.get('line-height'))}, not ${extra.lh}`);
+        if (bad.length) {
+          const k = `${name} · ${way.name} · ${bad.join(', ')}`;
+          if (!fails.some((f) => f.endsWith(k))) fails.push(`${where} · "${String(n.text || '').trim().slice(0, 30)}" · ${k}`);
+        }
+      }
+    }
+  }
+}
